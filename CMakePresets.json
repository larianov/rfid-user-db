{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "PICO_BOARD": "pico",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "e",
      "displayName": "Embedded Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/embedded-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "er",
      "displayName": "Embedded Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/embedded-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "e",  "configurePreset": "e" },
    { "name": "er", "configurePreset": "er" }
  ]
}
